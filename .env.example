# Database
DATABASE_URL=postgresql://username:password@localhost:5432/ivaa_adsync

# JWT
JWT_SECRET=your-jwt-secret-key-here

# Server
PORT=5000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Resend Email Configuration
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@ivaa-adsync.com

# Frontend URLs (comma-separated for multiple domains)
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Ideal Postcodes API
IDEAL_POSTCODES_API_KEY=your-ideal-postcodes-api-key

# DigitalOcean Spaces Configuration
DO_SPACES_ENDPOINT=fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_CDN_URL=https://your-cdn-domain.com